# Copy to deploy/.env.production on the server and fill in. chmod 600. Never commit it.
# Generate secrets with:  openssl rand -hex 24   (letters and digits only; the database
# password goes into a URL, so deploy.sh refuses characters such as / + =)

ENVIRONMENT=production

# --- Site ---------------------------------------------------------------
# The domain Caddy serves (no scheme). Use :80 only for local testing.
SITE_ADDRESS=jobmigo.com
# The public https URL, used in emails and share tags. Both must match SITE_ADDRESS.
BETTER_AUTH_URL=https://jobmigo.com
PUBLIC_URL=https://jobmigo.com

# --- Secrets ------------------------------------------------------------
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Shared secret between the web app and the AI engine: openssl rand -hex 32
ENGINE_TOKEN=

# --- AI models (read by the engine only) --------------------------------
# Each tier is "provider/model-id" (deepseek, moonshot or openrouter). Leave empty to
# keep AI off; any call that needs it then fails with a clear message.
AI_CHEAP_MODEL=
AI_STRONG_MODEL=
# Optional USD per million tokens as "input,output"; without it cost is not recorded.
AI_CHEAP_PRICE=
AI_STRONG_PRICE=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Jobmigo <hello@jobmigo.com>
MAIL_FROM=
# Shown in the footer and privacy notice
CONTACT_EMAIL=

# --- Proxy trust --------------------------------------------------------
# TRUST_PROXY_HEADERS=true is only safe together with CLOUDFLARE_ONLY=true, which makes
# Caddy return 403 to anything that did not come from Cloudflare. Keep both false until
# the site works through Cloudflare, then turn both on together.
TRUST_PROXY_HEADERS=false
CLOUDFLARE_ONLY=false

# --- Backups (used by backup.sh) -----------------------------------------
# rclone remote and path, e.g. r2:jobmigo-backups
BACKUP_REMOTE=
# age public key (age1...). The private key stays off the server.
AGE_RECIPIENT=

# Local testing only: HTTP_PORT=8088
