# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://jobmigo:jobmigo@localhost:5442/jobmigo
WEB_ORIGIN=http://localhost:3000

# Better Auth (web server) and how the API verifies its tokens
AUTH_DATABASE_URL=postgresql://jobmigo:jobmigo@localhost:5442/jobmigo
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
VITE_API_URL=http://localhost:8001
