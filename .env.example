# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=local
DATABASE_URL=postgresql://jobmigo:jobmigo@localhost:5442/jobmigo
# Tests drop and recreate this database's schema; the name must end in _test.
TEST_DATABASE_URL=postgresql://jobmigo:jobmigo@localhost:5442/jobmigo_test

# Better Auth (runs inside the web app)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public site and waitlist email (feature 28a)
# Base URL used in email links and share tags; defaults to BETTER_AUTH_URL.
# PUBLIC_URL=http://localhost:3000
# Resend API key and a sender on a domain you have verified. With no key and
# ENVIRONMENT=local, emails are printed to the dev server log instead.
# RESEND_API_KEY=
# MAIL_FROM=Jobmigo <hello@yourdomain.com>
# Shown in the footer and the privacy notice; leave unset to hide it.
# CONTACT_EMAIL=
# Set to true ONLY behind Cloudflare and Caddy (feature 28b), where cf-connecting-ip
# cannot be set by a visitor. Without it the per-IP waitlist limit is skipped and only
# the global cap applies.
# TRUST_PROXY_HEADERS=false

# AI gateway (feature 31, in the engine). Pick a provider and model id from the provider's own
# docs; nothing is guessed for you. Providers: deepseek, moonshot, openrouter, gemini, groq, cloudflare
# (gemini, groq and cloudflare have free tiers; free tiers may use your prompts for training, so use
# them with test data only). Cloudflare also needs CLOUDFLARE_ACCOUNT_ID.
# Each tier is "provider/model-id". Cheap handles parsing and screening, strong
# handles evaluation and drafting. Set at least AI_CHEAP_MODEL and its key.
# AI_CHEAP_MODEL=deepseek/<model-id>
# AI_STRONG_MODEL=deepseek/<model-id>
# Optional, USD per million tokens as "input,output"; without it cost is not recorded.
# AI_CHEAP_PRICE=0.30,1.20
# AI_STRONG_PRICE=1.00,4.00
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# AI engine (feature 30). The web server calls it with this token and the verified user id.
# Generate the token with: openssl rand -hex 32  (at least 32 characters)
ENGINE_URL=http://localhost:8100
ENGINE_TOKEN=
# Engine tests use their own database so they never touch the web tests' data.
ENGINE_TEST_DATABASE_URL=postgresql://jobmigo:jobmigo@localhost:5442/jobmigo_engine_test

# Object storage for uploaded CVs (feature 3a, used by the engine). These are the local
# RustFS values from docker-compose.yml (service `storage`); production uses R2 or B2.
STORAGE_ENDPOINT=http://localhost:9100
STORAGE_BUCKET=jobmigo
STORAGE_KEY=jobmigo
STORAGE_SECRET=jobmigo-dev-secret
# STORAGE_REGION=us-east-1
# Signed download links are built for this address when the engine reaches storage by
# another name (the full compose stack). Defaults to STORAGE_ENDPOINT.
# STORAGE_PUBLIC_ENDPOINT=
# Set to 1 to run the adapter tests against the local store (uses a jobmigo-test bucket).
# STORAGE_LIVE_TEST=1

# Added by later features
# PAYSTACK_SECRET_KEY=
# PADDLE_API_KEY=
# TELEGRAM_BOT_TOKEN=
# SENTRY_DSN=
